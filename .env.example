# Notion 내부 통합 토큰
#   1) https://www.notion.so/my-integrations 에서 발급
#   2) 각 DB를 풀페이지로 연 뒤 ... > 연결 > 통합 추가 로 권한을 줘야 함
#      (이걸 빼먹으면 쿼리는 성공하는데 결과가 0건으로 나옴)
NOTION_TOKEN=secret_xxxxxxxxxxxx
NOTION_VERSION=2025-09-03

# 임베딩용
OPENAI_API_KEY=sk-xxxxxxxxxxxx
EMBED_MODEL=text-embedding-3-small

# 디스코드 봇
#   Bot > Reset Token 으로 발급
#   Bot > Privileged Gateway Intents > MESSAGE CONTENT INTENT 를 켜야 함
DISCORD_TOKEN=
# 멘션 없이도 반응할 채널 ID. 쉼표로 여러 개. 비우면 /거북 명령만 동작한다.
BOT_CHANNEL_IDS=

# 인사/농담/일반상식에 가볍게 답하는 잡담 경로. 0 으로 끌 수 있다.
# 게임 질문은 이 경로로 가지 않는다 (answer.py 의 두 겹 방어 참고).
SMALLTALK=1

# 로컬 저장소 경로
GOBUK_DB_PATH=./gobuk.sqlite3
